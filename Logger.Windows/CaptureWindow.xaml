<Window x:Class="Logger.Windows.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Logger"
        Width="372"
        SizeToContent="Height"
        MaxHeight="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        ShowActivated="True"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <DataTemplate x:Key="HitTemplate">
            <Button Focusable="False" Click="Row_Click" MouseEnter="Row_MouseEnter"
                    HorizontalContentAlignment="Stretch" Padding="10,8" Cursor="Hand" BorderThickness="0">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF1E2230"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FF232734"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
                <Grid>
                    <StackPanel Margin="0,0,72,0">
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="14"/>
                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Trailing}" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource AccentBrush}" FontSize="13"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>
    <Border Margin="14" CornerRadius="16" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="16,16,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Grid Grid.Column="1">
                    <TextBlock x:Name="Placeholder" Text="Task name" Foreground="{StaticResource MutedBrush}" FontSize="18"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                             CaretBrush="{StaticResource AccentBrush}" FontSize="18" Padding="0"
                             TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </Grid>

            <ScrollViewer Grid.Row="1" MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="8,0,8,4">
                <StackPanel>
                    <TextBlock x:Name="OpenHeader" Text="OPEN" Style="{StaticResource SectionLabel}"/>
                    <ItemsControl x:Name="OpenList" ItemTemplate="{StaticResource HitTemplate}"/>
                    <TextBlock x:Name="TaskHeader" Text="TASKS" Style="{StaticResource SectionLabel}"/>
                    <ItemsControl x:Name="TaskList" ItemTemplate="{StaticResource HitTemplate}"/>
                    <TextBlock x:Name="EmptyText" Text="Type a name and press Enter." Foreground="{StaticResource MutedBrush}"
                               Margin="10,12,10,16" FontSize="13"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel x:Name="ExpectPanel" Grid.Row="2" Margin="12,0,12,4" Visibility="Collapsed">
                <TextBlock x:Name="ExpectHint" Text="Default for the next start" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,2,4,6"/>
                <WrapPanel>
                    <Button Content="15m" Tag="15m" Style="{StaticResource GhostButton}" Click="Preset_Click" Focusable="False"/>
                    <Button Content="30m" Tag="30m" Style="{StaticResource GhostButton}" Click="Preset_Click" Focusable="False"/>
                    <Button Content="1h" Tag="1h" Style="{StaticResource GhostButton}" Click="Preset_Click" Focusable="False"/>
                    <Button Content="2h" Tag="2h" Style="{StaticResource GhostButton}" Click="Preset_Click" Focusable="False"/>
                    <Button Content="4h" Tag="4h" Style="{StaticResource GhostButton}" Click="Preset_Click" Focusable="False"/>
                    <Button Content="8h" Tag="8h" Style="{StaticResource GhostButton}" Click="Preset_Click" Focusable="False"/>
                    <Button Content="1d" Tag="1d" Style="{StaticResource GhostButton}" Click="Preset_Click" Focusable="False"/>
                </WrapPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Set" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="ApplyExpect_Click" Focusable="False"/>
                    <TextBox x:Name="ExpectBox" Background="{StaticResource CardBrush}" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource LineBrush}" CaretBrush="{StaticResource AccentBrush}"
                             Padding="8,6" FontSize="13"/>
                </DockPanel>
            </StackPanel>

            <UniformGrid Grid.Row="3" Columns="4" Margin="12,4,12,12">
                <Button x:Name="StartButton" Content="Start" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="Start_Click" Focusable="False"/>
                <Button x:Name="EndButton" Content="End" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="End_Click" Focusable="False"/>
                <Button x:Name="ExpectButton" Content="Expect" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Click="Expect_Click" Focusable="False"/>
                <Button x:Name="JournalButton" Content="Journal" Style="{StaticResource GhostButton}" Margin="0" Click="Journal_Click" Focusable="False"/>
            </UniformGrid>
        </Grid>
    </Border>
</Window>
