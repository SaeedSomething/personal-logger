#!/bin/sh
# Bump <Version> in each project whose staged files changed.
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File scripts/bump-package-versions.ps1 -Mode pre-commit
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/bump-package-versions.ps1 -Mode pre-commit
else
  echo "PowerShell is required to bump package versions." >&2
  exit 1
fi
