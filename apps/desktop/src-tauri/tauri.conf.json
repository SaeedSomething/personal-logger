{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Logger",
  "version": "1.4.0",
  "identifier": "com.personallogger.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --prefix ../web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Personal Logger",
        "width": 1180,
        "height": 780,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "capture",
        "title": "Capture",
        "url": "/?view=capture&compact=1",
        "width": 420,
        "height": 520,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "Personal Logger"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:logger.db"]
    }
  }
}
